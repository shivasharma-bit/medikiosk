# ── MediKiosk settings (this file is copied to .env automatically on first start) ──

# AI summaries: free key from https://aistudio.google.com/apikey  (paste after the = sign)
# Without a key the app still works but uses a simple auto-written summary instead of Gemini.
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Database: leave EMPTY to use the built-in database (no install needed, saved in %LOCALAPPDATA%\MediKiosk\mongo).
# Or paste a MongoDB Atlas / local connection string here.
MONGODB_URI=

PORT=5000
